# PROJECT TITAN-X Environment Configuration
# Copy to .env and fill in values

# Application
APP_NAME=PROJECT_TITAN_X
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-vault
# Loopback by default. Only widen this together with API_KEY below.
API_HOST=127.0.0.1
API_PORT=8000
# Shared secret for the API. When set, every route except /, /health and the
# docs requires an X-API-Key header matching it. Leave blank ONLY while bound
# to loopback. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Comma-separated CORS origin allowlist. The bundled dashboard is same-origin
# and needs no entry here; add one only for a separately hosted front end.
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=titanx
POSTGRES_PASSWORD=titanx_secret
POSTGRES_DB=titanx

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=knowledge

# Capital (small account — no equities)
STARTING_CAPITAL=10000
CAPITAL_CURRENCY=INR
DEFAULT_RISK_PER_TRADE_PCT=0.5
MAX_RISK_PER_TRADE_PCT=1.0
EQUITIES_ENABLED=false

# Risk Limits (CRO Engine - absolute authority)
MAX_DAILY_LOSS_PCT=2.0
MAX_WEEKLY_LOSS_PCT=5.0
MAX_MONTHLY_LOSS_PCT=10.0
MAX_DRAWDOWN_PCT=20.0
MAX_RISK_OF_RUIN_PCT=1.0
MAX_PORTFOLIO_HEAT_PCT=4.0
MIN_RISK_REWARD_RATIO=2.0
MIN_SIGNAL_CONFIDENCE=20

# Data Providers
YAHOO_FINANCE_ENABLED=true
# Free-tier Alpha Vantage keys are limited to 25 requests/day (see
# https://www.alphavantage.co/premium/ for current limits). Used as a
# fallback for e02_market_data (forex/crypto) and for official economic
# indicators in e03_macro (CPI, Fed Funds Rate, Treasury Yield, GDP,
# Unemployment). Responses are cached to disk and quota-tracked locally.
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_DAILY_LIMIT=25
TWELVE_DATA_API_KEY=
# Powers E13 Derivatives' real NIFTY50/BANKNIFTY option-chain read (see
# core/data_providers/kite_option_chain.py, GET /api/v1/derivatives/
# india-option-chain). Requires a paid Zerodha Kite Connect developer
# subscription (developers.kite.trade). kite_access_token expires DAILY --
# Zerodha does not officially support headless/TOTP login for Kite
# Connect, so refreshing this is a manual (or externally, human-
# authorized) step, not something this platform automates. Left unset,
# that route returns an honest "not configured" gap rather than
# fabricated data. Read-only (Rule 5): never used to place, modify, or
# cancel an order.
KITE_API_KEY=
KITE_ACCESS_TOKEN=

# Execution (human approval required)
EXECUTION_MODE=research
MT5_ENABLED=false
ZERODHA_ENABLED=false
BINANCE_ENABLED=false

# LLM (optional - for multi-agent committee)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Proxy settings REMOVED 2026-08-27. These configured Webshare rotating
# RESIDENTIAL proxies to get past YouTube's IP block on the transcript
# endpoint. Cycling proxies to defeat an IP block circumvents a technical
# access restriction and is against YouTube's terms, so the support was
# taken out of transcript_collector.py rather than left switchable.
# If a run gets blocked: wait, lower the rate, or resume later.
# scripts/youtube_scraper.py is the sequential collector built for this.
